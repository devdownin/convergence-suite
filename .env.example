# Suite Convergence — configuration locale.
# Copier en .env (non versionné) avec scripts/init-env.sh, qui génère les secrets vides ci-dessous.
# Une variable « requise » vide fait échouer `docker compose` avec un message explicite.

# ─── Modules ────────────────────────────────────────────────────────────────────
# compose.yaml est le cœur ; ajouter les surcouches voulues, séparées par « : ».
# (Sous Windows, ajouter COMPOSE_PATH_SEPARATOR=; et séparer par « ; ».)
#   docs        SpectraLLM : RAG, MCP documentaire, LLM local pour KafkaExplorer (~16 Go de RAM)
#   monitoring  Prometheus, Alertmanager, Grafana
#   auth        Keycloak (royaume « supervision » d'Autoroutes)
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:compose.monitoring.yaml
# COMPOSE_FILE=compose.yaml:compose.docs.yaml:compose.monitoring.yaml:compose.auth.yaml

# ─── Secrets du cœur (requis) ───────────────────────────────────────────────────
# Bearer partagé entre KafkaExplorer (/mcp) et l'agent.
EXPLORER_MCP_AUTH_TOKEN=
# Bearer de l'API et du Control Center de Kex-anHarness.
KEX_AGENT_API_KEY=
# Base PostgreSQL d'Autoroutes.
AUTOROUTES_POSTGRES_PASSWORD=

# ─── Modèle de l'agent (facultatif : sans clé, l'agent démarre dégradé) ─────────
KEX_AGENT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# KEX_AGENT_LLM_PROVIDER=openai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ─── Module docs (requis avec compose.docs.yaml) ────────────────────────────────
SPECTRA_API_KEY=
# Clé MCP de l'agent Kex, limitée aux collections suite_specs, ops_runbooks, ops_incidents.
SPECTRA_KEX_CALLER_KEY=
# Portable : modèle 3B au lieu du 7B. Les quatre variables vont ensemble.
# LLM_CHAT_MODEL_NAME=qwen2.5-3b-instruct
# LLM_CHAT_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# SPECTRA_CHAT_MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-3B-Instruct-GGUF/resolve/main/Qwen2.5-3B-Instruct-Q4_K_M.gguf
# SPECTRA_AUTO_INSTALL_MODELS=false

# ─── Module monitoring (requis avec compose.monitoring.yaml) ────────────────────
GRAFANA_PASSWORD=

# ─── Module auth (requis avec compose.auth.yaml) ────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=
SUPERVISION_CLIENT_SECRET=
KEYCLOAK_VIEWER_PASSWORD=
KEYCLOAK_ADMIN_USER_PASSWORD=
MCP_AGENT_CLIENT_SECRET=
# Client Keycloak « kex-supervisor » : source mcp:service-account-kex-supervisor côté Autoroutes.
KEX_SUPERVISOR_CLIENT_SECRET=
# Carte authentifiée (profil auth d'Autoroutes).
# AUTOROUTES_SUPERVISION_PROFILE=auth
# Avec le module auth, le MCP d'Autoroutes est sous jeton Keycloak (Kex 0.13.0 ou plus le renouvelle).
# false pour le désactiver, par exemple avec une image Kex plus ancienne.
# AUTOROUTES_MCP_SECURITY_ENABLED=false

# ─── Versions épinglées (docs/versions.md) ──────────────────────────────────────
EXPLORER_IMAGE_TAG=2.4.1
KEX_AGENT_IMAGE_TAG=0.13.1
SPECTRA_IMAGE_TAG=0.12.3
AUTOROUTES_TAG=0.5.3
KAFKA_IMAGE_TAG=4.4.0

# ─── Ports (ADR 0001) — valeurs par défaut ──────────────────────────────────────
# BIND_ADDR=127.0.0.1
# EXPLORER_PORT=8080
# KEX_AGENT_PORT=8081
# AUTOROUTES_UI_PORT=8084
# AUTOROUTES_API_PORT=8085
# SPECTRA_UI_PORT=8088
# SPECTRA_API_PORT=8089
# AUTOROUTES_MCP_PORT=8090
# KEYCLOAK_PORT=8180
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# KAFKA_HOST_PORT=9092
# PROXY_HTTPS_PORT=8443

# ─── Divers ─────────────────────────────────────────────────────────────────────
# Débit du simulateur d'Autoroutes, en événements par seconde (données SIMULÉES).
SIMULATOR_RATE=80
